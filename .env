# Соцсети
GO_TO_VK_URL="Сылка на группу в VK"
BASE_URL="https://website.ru" #schema + host 
# вход через соцсети Oauth
VK_APP_ID=1111111 #ID в настройках приложения в dev.vk.ru
VK_APP_SECRET='Защищённый ключ в приложении VK'
VK_AUTH_CALLBACK_URL="/api/.../callback/route.js"  # относительный путь от папки app/ lj
VK_AUTH_URL="https://id.vk.ru/authorize"  
VK_TOKEN_URL="https://id.vk.ru/oauth2/auth"
VK_USER_INFO_URL="https://id.vk.ru/oauth2/public_info"
VK_JWKS_URL="https://id.vk.ru/.well-known/jwks" 


NEXT_PUBLIC_EXPRESS_API_REGISTRATION_URL="schema://host:port/auth/registration" # для клиентских компонентов бэк на node + express
NEXT_PUBLIC_EXPRESS_API_LOGIN_URL="schema://host:port/auth/login" #для клиентских компонентов
NEXT_PUBLIC_EXPRESS_API_LOGOUT_URL="schema://host:port/auth/logout"
NEXT_PUBLIC_SITE_URL = "schema://host:port" # Это не секретная информация поэтому оставим одну переменную с префиксом 'NEXT_PUBLIC_'

JWT_SECRET = 'secret_key' #секретный ключ должен совпадать с секретным ключом на бэкенде с помощью которого подписывали JWT